# Copy to .env and fill in. `.env` is gitignored — keep it that way.
#   cp .env.example .env

# ---------------------------------------------------------------- server
PORT=3000
HOST=127.0.0.1

# Pin the service timezone. Do not rely on the host clock: batches are bucketed
# by business day, and a host in a different zone silently files documents
# under the wrong day.
TZ=UTC

# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- storage
# Root for uploaded documents, generated exports and the SQLite file.
# Use an absolute path in production; keep it off the application volume so a
# redeploy cannot wipe operator data.
STORAGE_ROOT=./storage

# ---------------------------------------------------------------- auth
# Set false only for a throwaway local spike. Every route except /healthz and
# /readyz is unauthenticated when this is off.
AUTH_ENABLED=true

# REQUIRED when AUTH_ENABLED=true. Generate one, never reuse an example value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session lifetime for the auth cookie.
JWT_EXPIRES_IN=24h

# Set true when served over HTTPS so the cookie gets the Secure flag.
AUTH_COOKIE_SECURE=false

# First-run admin. Leave the password blank and use `npm run users` instead if
# you would rather not put a credential in a file at all.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Failed logins allowed per window, per IP.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------- uploads
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_MAX_FILES_PER_REQUEST=500

# ---------------------------------------------------------------- recognition
# Which provider extracts fields from a document image.
#   mock — deterministic fake output; used by tests and a fresh checkout
#   http — POST the image to your own model service (see RECOGNITION_ENDPOINT)
# Register your own in lib/recognition/provider_registry.js.
RECOGNITION_PROVIDER=mock

# Required when RECOGNITION_PROVIDER=http.
RECOGNITION_ENDPOINT=
RECOGNITION_API_KEY=
RECOGNITION_TIMEOUT_MS=30000

# How many documents one recognition stage processes concurrently. Raise until
# your model service becomes the bottleneck, not before.
RECOGNITION_CONCURRENCY=2

# A field below this confidence is queued for human review instead of
# auto-accepted. Tune against your own labelled sample — the default is a guess.
RECOGNITION_REVIEW_THRESHOLD=0.85
